<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="KSHPLAYER.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="KSHPLAYER">

    <!-- Charte KSHFLIX 2.0 « Salle obscure » -->
    <Grid Background="#050506" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
        <Grid.Resources>
            <FontFamily x:Key="Brand">ms-appx:///Assets/Unbounded.ttf#Unbounded</FontFamily>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBar" Grid.Row="0" Padding="16,0" />

        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="26">
            <!-- Logo : même marque néon que KSHFLIX + KSH blanc / PLAYER rouge -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
                <Image Source="ms-appx:///Assets/logo-mark.png" Width="64" Height="64" />
                <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource Brand}"
                           FontSize="46" FontWeight="ExtraBold" CharacterSpacing="-20">
                    <Run Text="KSH" Foreground="#F4F4F6" /><Run Text="PLAYER" Foreground="#F0283A" />
                </TextBlock>
                <Border x:Name="ProBadge" Visibility="Collapsed" VerticalAlignment="Center" Margin="2,6,0,0"
                        Padding="10,4" CornerRadius="9" Background="#F0283A">
                    <TextBlock Text="PRO" FontFamily="{StaticResource Brand}" FontSize="16"
                               FontWeight="ExtraBold" Foreground="White" />
                </Border>
            </StackPanel>

            <!-- Carte de dépôt -->
            <Border Width="480" Padding="30,28" CornerRadius="22" Background="#121217"
                    BorderBrush="#1AFFFFFF" BorderThickness="1">
                <StackPanel Spacing="18" HorizontalAlignment="Center">
                    <TextBlock x:Name="EyebrowText" Text="LECTEUR VIDÉO" HorizontalAlignment="Center" FontSize="11"
                               FontWeight="ExtraBold" CharacterSpacing="160" Foreground="#FF8A95" />
                    <TextBlock x:Name="StatusText" Text="Glisse un film ou un épisode ici" TextWrapping="Wrap"
                               TextAlignment="Center" FontSize="16" Foreground="#B9B9C2" HorizontalAlignment="Center" />
                    <Button Click="OnOpenClick" HorizontalAlignment="Center" Padding="22,11"
                            CornerRadius="14" Background="#F0283A" Foreground="White" BorderThickness="0">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FF3A4B" />
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#C81E30" />
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="Ouvrir un fichier" FontWeight="Bold" FontSize="15" />
                            <FontIcon Glyph="&#xE72A;" FontSize="14" />
                        </StackPanel>
                    </Button>
                    <HyperlinkButton x:Name="OpenFolderButton" Visibility="Collapsed" HorizontalAlignment="Center"
                                     Click="OnOpenFolderClick" Foreground="#B9B9C2" FontSize="13">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8B7;" FontSize="13" />
                            <TextBlock Text="Ouvrir une séquence d'images (dossier)" />
                        </StackPanel>
                    </HyperlinkButton>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Bandeau de mise à jour -->
        <Border x:Name="UpdateBar" Grid.Row="1" Visibility="Collapsed" Margin="0,8,0,0"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Padding="16,10" CornerRadius="16" Background="#121217" BorderBrush="#F0283A" BorderThickness="1">
            <StackPanel Orientation="Horizontal" Spacing="14">
                <Ellipse Width="8" Height="8" Fill="#F0283A" VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center" MaxWidth="420">
                    <TextBlock x:Name="UpdateText" FontWeight="SemiBold" FontSize="13" Foreground="#F4F4F6" />
                    <TextBlock x:Name="UpdateNotes" FontSize="11" Foreground="#B9B9C2" TextWrapping="Wrap" MaxLines="2"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button x:Name="UpdateButton" Click="OnUpdateClick" Padding="14,6" CornerRadius="10"
                        Background="#F0283A" Foreground="White" BorderThickness="0" VerticalAlignment="Center">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FF3A4B" />
                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                    </Button.Resources>
                    <TextBlock Text="Mettre à jour" FontWeight="Bold" FontSize="13" />
                </Button>
            </StackPanel>
        </Border>

        <!-- Pastille carte graphique / mode -->
        <Border Grid.Row="1" Margin="0,0,0,22" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Padding="12,6" CornerRadius="14" Background="#121217" BorderBrush="#1AFFFFFF" BorderThickness="1">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Ellipse Width="7" Height="7" Fill="#F0283A" VerticalAlignment="Center" />
                <TextBlock x:Name="HardwareText" FontSize="12" Foreground="#B9B9C2" />
                <TextBlock x:Name="VersionText" FontSize="12" Foreground="#7A7A84" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
