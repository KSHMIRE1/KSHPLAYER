<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Le lecteur Windows : KSHPLAYER.exe (configurations Debug / Release) et KSHPLAYERPRO.exe (DebugPro / ReleasePro).
    Depuis 1.2, plus d'écran d'accueil : un fichier ouvert (double-clic, « Ouvrir avec », Entrée dans l'aperçu Espace)
    s'affiche tout de suite dans la fenêtre sans bord de mpv, et fermer la vidéo ferme KSHPLAYER. Lancé sans fichier,
    il propose la fenêtre « Ouvrir » de Windows.
    Sans écran à dessiner, WinUI ne servait plus à rien : .NET Framework 4.8 (déjà dans Windows 10 / 11), un exe de
    quelques dizaines de Ko, démarrage plus rapide, installateur environ 3 fois plus léger.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>KSHPLAYER</RootNamespace>
    <AssemblyName>KSHPLAYER</AssemblyName>
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)VERSION').Trim())</Version>
    <Product>KSHPLAYER</Product>
    <Company>KSHMIRE</Company>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\KSHPLAYER.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Configurations>Debug;Release;DebugPro;ReleasePro</Configurations>
  </PropertyGroup>

  <!-- Édition PRO (monteurs) : configurations DebugPro / ReleasePro -->
  <PropertyGroup Condition="'$(Configuration)' == 'DebugPro' Or '$(Configuration)' == 'ReleasePro'">
    <DefineConstants>$(DefineConstants);KSHPRO</DefineConstants>
    <AssemblyName>KSHPLAYERPRO</AssemblyName>
    <Product>KSHPLAYER PRO</Product>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'DebugPro'">
    <DefineConstants>$(DefineConstants);DEBUG;TRACE</DefineConstants>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
    <Optimize>false</Optimize>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release' Or '$(Configuration)' == 'ReleasePro'">
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!-- Moteur libmpv (build x86_64 standard, compatible tous processeurs) : extrait une fois depuis l'archive -->
  <PropertyGroup>
    <MpvArchiveName>mpv-dev-x86_64-20261012-git-88eb9f2e73.7z</MpvArchiveName>
    <MpvArchive>$(MSBuildProjectDirectory)\third_party\mpv\$(MpvArchiveName)</MpvArchive>
    <MpvArchive Condition="!Exists('$(MpvArchive)')">$(USERPROFILE)\Downloads\$(MpvArchiveName)</MpvArchive>
    <MpvEngineDir>$(MSBuildProjectDirectory)\engine</MpvEngineDir>
  </PropertyGroup>

  <Target Name="ExtractLibMpv" BeforeTargets="BeforeBuild" Condition="!Exists('$(MpvEngineDir)\libmpv-2.dll')">
    <Error Condition="!Exists('$(MpvArchive)')" Text="Moteur libmpv manquant et archive introuvable : $(MpvArchive)" />
    <MakeDir Directories="$(MpvEngineDir)" />
    <Exec Command="&quot;$(SystemRoot)\System32\tar.exe&quot; -xf &quot;$(MpvArchive)&quot; -C &quot;$(MpvEngineDir)&quot; libmpv-2.dll" />
    <ItemGroup>
      <None Include="engine\libmpv-2.dll" Link="libmpv-2.dll" CopyToOutputDirectory="Always" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <None Update="engine\libmpv-2.dll" Link="libmpv-2.dll" CopyToOutputDirectory="Always" />
    <!-- Barre de contrôle KSHPLAYER, polices (icônes Material Icons, Apache 2.0 ; Unbounded, OFL) et raccourcis -->
    <None Update="mpv\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="mpv\scripts\uosc\**\*;mpv\script-opts\**\*;mpv\fonts\uosc_textures.ttf" CopyToOutputDirectory="Never" />
    <None Remove="libmpv-2.dll" />
    <!-- l'installateur (Setup\) et l'aperçu Espace (Apercu\) sont des projets à part : exclus du lecteur -->
    <Compile Remove="Setup\**" />
    <Compile Remove="Apercu\**" />
    <None Remove="Apercu\**" />
    <EmbeddedResource Remove="Apercu\**" />
    <None Remove="macOS\**" />
    <None Remove="third_party\**" />
    <None Remove="Setup\**" />
    <EmbeddedResource Remove="Setup\**" />
    <!-- l'icône est dans l'exe ; logo et police servent à l'installateur (Setup\) et au Mac -->
    <None Remove="Assets\**" />
    <!-- anciens fichiers de l'accueil WinUI (jusqu'en 1.1.x) : ignorés s'il en reste dans une copie du projet -->
    <Compile Remove="App.xaml.cs;MainWindow.xaml.cs" />
    <None Remove="App.xaml;MainWindow.xaml" />
  </ItemGroup>
</Project>
