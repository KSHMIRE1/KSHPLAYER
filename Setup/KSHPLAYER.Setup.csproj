<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Installateur KSHPLAYER / KSHPLAYER PRO.
    .NET Framework 4.8 = présent d'office sur Windows 10/11 : le Setup.exe est un fichier unique, sans rien à installer avant.
    À la compilation, ce projet compile le lecteur et l'aperçu Espace (.NET Framework 4.8), y joint le moteur libmpv
    et le dossier mpv, compresse le tout et l'intègre dans l'exe (≈ 35 Mo, dont 34 pour le moteur).
      Release     -> KSHPLAYER-Setup.exe
      ReleasePro  -> KSHPLAYER-PRO-Setup.exe
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Configurations>Debug;Release;DebugPro;ReleasePro</Configurations>
    <RootNamespace>KSHPLAYER.Setup</RootNamespace>
    <ApplicationIcon>..\Assets\KSHPLAYER.ico</ApplicationIcon>
    <ApplicationManifest>setup.manifest</ApplicationManifest>
    <AssemblyName>KSHPLAYER-Setup</AssemblyName>
    <KshAppConfig>Release</KshAppConfig>
    <AppExe>KSHPLAYER.exe</AppExe>
    <ApercuExe>KSHPLAYER-Apercu.exe</ApercuExe>
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\VERSION').Trim())</Version>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'DebugPro' Or '$(Configuration)' == 'ReleasePro'">
    <DefineConstants>$(DefineConstants);KSHPRO</DefineConstants>
    <AssemblyName>KSHPLAYER-PRO-Setup</AssemblyName>
    <KshAppConfig>ReleasePro</KshAppConfig>
    <AppExe>KSHPLAYERPRO.exe</AppExe>
    <ApercuExe>KSHPLAYERPRO-Apercu.exe</ApercuExe>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <EmbeddedResource Include="..\Assets\logo-mark.png" LogicalName="logo.png" />
    <!-- « Nouveautés » affichées sur l'écran de mise à jour -->
    <EmbeddedResource Include="..\NOTES.txt" LogicalName="notes.txt" />
  </ItemGroup>

  <!-- 1) compile le lecteur et l'aperçu, 2) compresse le tout (LZMS), 3) l'intègre dans l'installateur -->
  <PropertyGroup>
    <PayloadDir>$(MSBuildProjectDirectory)\obj\payload\$(KshAppConfig)\app\</PayloadDir>
    <PayloadPak>$(MSBuildProjectDirectory)\obj\payload\$(KshAppConfig)\payload.kpk</PayloadPak>
  </PropertyGroup>

  <Target Name="BuildPayload" BeforeTargets="BeforeBuild">
    <Message Importance="high" Text="KSHPLAYER : compilation du lecteur ($(KshAppConfig))…" />
    <RemoveDir Directories="$(PayloadDir)" />
    <!-- Lecteur : petit exe .NET Framework 4.8 + moteur libmpv-2.dll + dossier mpv (barre, polices, raccourcis) -->
    <MSBuild Projects="..\KSHPLAYER.csproj" Targets="Restore"
             Properties="Configuration=$(KshAppConfig);Platform=x64;_KshRestore=1" />
    <MSBuild Projects="..\KSHPLAYER.csproj" Targets="Build"
             Properties="Configuration=$(KshAppConfig);Platform=x64;OutDir=$(PayloadDir)" />
    <Error Condition="!Exists('$(PayloadDir)$(AppExe)')" Text="La compilation du lecteur a échoué ($(AppExe) introuvable)." />
    <Error Condition="!Exists('$(PayloadDir)libmpv-2.dll')" Text="Le moteur libmpv-2.dll manque à côté du lecteur." />
    <!-- Aperçu à la barre Espace + désinstallateur (petit exe .NET Framework, à côté du lecteur) -->
    <MSBuild Projects="..\Apercu\KSHPLAYER.Apercu.csproj" Targets="Restore"
             Properties="Configuration=$(KshAppConfig);Platform=x64;_KshRestore=1" />
    <MSBuild Projects="..\Apercu\KSHPLAYER.Apercu.csproj" Targets="Build"
             Properties="Configuration=$(KshAppConfig);Platform=x64;OutDir=$(PayloadDir)" />
    <Error Condition="!Exists('$(PayloadDir)$(ApercuExe)')" Text="L'aperçu Espace n'a pas été compilé ($(ApercuExe) introuvable)." />
    <!-- rien de superflu dans l'installateur -->
    <ItemGroup>
      <KshTrim Include="$(PayloadDir)*.pdb;$(PayloadDir)*.xml" />
    </ItemGroup>
    <Delete Files="@(KshTrim)" />
    <KshPack SourceDir="$(PayloadDir)" OutputFile="$(PayloadPak)" />
    <ItemGroup>
      <EmbeddedResource Include="$(PayloadPak)" LogicalName="payload.kpk" />
    </ItemGroup>
  </Target>

  <!--
    Après compilation (Release / ReleasePro) : copie de l'installateur sur le NAS
    et récupération des dernières versions Mac (.dmg) depuis GitHub.
      K:\Backup\Logiciel KSHPC\KSHPLAYER\Windows\   et   \Mac\
  -->
  <PropertyGroup>
    <KshNasDir>K:\Backup\Logiciel KSHPC\KSHPLAYER</KshNasDir>
    <KshDmgUrl>https://raw.githubusercontent.com/KSHMIRE1/KSHPLAYER/telechargements</KshDmgUrl>
  </PropertyGroup>
  <Target Name="KshDeployNas" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' Or '$(Configuration)' == 'ReleasePro'">
    <Message Importance="high" Condition="!Exists('K:\Backup')" Text="KSHPLAYER : NAS (K:) introuvable, copie ignorée." />
    <MakeDir Condition="Exists('K:\Backup')" Directories="$(KshNasDir)\Windows;$(KshNasDir)\Mac" ContinueOnError="true" />
    <Copy Condition="Exists('K:\Backup')" SourceFiles="$(TargetPath)" DestinationFolder="$(KshNasDir)\Windows" ContinueOnError="true" />
    <DownloadFile Condition="Exists('K:\Backup')" SourceUrl="$(KshDmgUrl)/KSHPLAYER.dmg" DestinationFolder="$(KshNasDir)\Mac" ContinueOnError="true" />
    <DownloadFile Condition="Exists('K:\Backup')" SourceUrl="$(KshDmgUrl)/KSHPLAYER-PRO.dmg" DestinationFolder="$(KshNasDir)\Mac" ContinueOnError="true" />
    <Message Importance="high" Condition="Exists('K:\Backup')" Text="KSHPLAYER : installateurs copiés sur le NAS ($(KshNasDir))" />
  </Target>

  <!--
    KshPack : compresse chaque fichier du lecteur avec LZMS, l'algorithme de compression intégré à Windows
    (celui des images d'installation de Windows). Rien à installer, et l'installateur décompresse avec le même moteur.
    Format : "KSHPAK1" | nb fichiers | (chemin, taille, mode, taille compressée, données)…
  -->
  <UsingTask TaskName="KshPack" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <SourceDir ParameterType="System.String" Required="true" />
      <OutputFile ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Class" Language="cs"><![CDATA[
using System;
using System.IO;
using System.Linq;
using System.Runtime.InteropServices;
using Microsoft.Build.Framework;
using Microsoft.Build.Utilities;

public class KshPack : Task
{
    [Required] public string SourceDir { get; set; }
    [Required] public string OutputFile { get; set; }

    [DllImport("cabinet.dll", SetLastError = true)]
    static extern bool CreateCompressor(uint algorithm, IntPtr alloc, out IntPtr handle);
    [DllImport("cabinet.dll", SetLastError = true)]
    static extern bool Compress(IntPtr h, byte[] src, UIntPtr srcSize, byte[] dst, UIntPtr dstSize, out UIntPtr outSize);
    [DllImport("cabinet.dll")]
    static extern bool CloseCompressor(IntPtr h);
    [DllImport("cabinet.dll", SetLastError = true)]
    static extern bool SetCompressorInformation(IntPtr h, int infoClass, ref int value, UIntPtr size);
    const uint LZMS = 5;
    const int BLOCK_SIZE = 1;

    public override bool Execute()
    {
        var root = Path.GetFullPath(SourceDir).TrimEnd('\\') + "\\";
        var files = Directory.GetFiles(root, "*", SearchOption.AllDirectories).OrderBy(f => f).ToArray();
        long inTotal = 0, outTotal = 0;
        IntPtr h;
        if (!CreateCompressor(LZMS, IntPtr.Zero, out h)) { Log.LogError("LZMS indisponible"); return false; }
        // blocs les plus grands possibles = meilleure compression (le moteur LZMS accepte jusqu'à 64 Mo selon les versions)
        foreach (var mb in new[] { 64, 32, 16, 8, 4 })
        {
            int bs = mb * 1024 * 1024;
            if (SetCompressorInformation(h, BLOCK_SIZE, ref bs, (UIntPtr)4)) { Log.LogMessage(MessageImportance.High, "KSHPLAYER : blocs LZMS de {0} Mo", mb); break; }
        }
        try
        {
            Directory.CreateDirectory(Path.GetDirectoryName(OutputFile));
            using (var w = new BinaryWriter(File.Create(OutputFile)))
            {
                w.Write("KSHPAK1");
                w.Write(files.Length);
                foreach (var f in files)
                {
                    var data = File.ReadAllBytes(f);
                    byte[] packed = null;
                    UIntPtr size = UIntPtr.Zero;
                    if (data.Length > 0)
                    {
                        Compress(h, data, (UIntPtr)data.Length, null, UIntPtr.Zero, out size);
                        var buf = new byte[(long)size.ToUInt64()];
                        if (Compress(h, data, (UIntPtr)data.Length, buf, (UIntPtr)buf.Length, out size) && (long)size.ToUInt64() < data.Length)
                        {
                            packed = new byte[(long)size.ToUInt64()];
                            Buffer.BlockCopy(buf, 0, packed, 0, packed.Length);
                        }
                    }
                    w.Write(f.Substring(root.Length).Replace('\\', '/'));
                    w.Write((long)data.Length);
                    w.Write(packed != null ? (byte)1 : (byte)0);
                    var payload = packed ?? data;
                    w.Write((long)payload.Length);
                    w.Write(payload);
                    inTotal += data.Length; outTotal += payload.Length;
                }
            }
        }
        finally { CloseCompressor(h); }
        Log.LogMessage(MessageImportance.High, "KSHPLAYER : {0} fichiers, {1:F1} Mo -> {2:F1} Mo (LZMS)", files.Length, inTotal / 1048576.0, outTotal / 1048576.0);
        return true;
    }
}
      ]]></Code>
    </Task>
  </UsingTask>
</Project>
